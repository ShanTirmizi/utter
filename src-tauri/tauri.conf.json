{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Utter",
  "version": "0.6.3",
  "identifier": "dev.utter.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Utter",
        "width": 760,
        "height": 640,
        "minWidth": 600,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 22
        }
      },
      {
        "label": "pill",
        "title": "Utter status",
        "width": 360,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFMDE3RDNCQjdBQkJFOEYKUldTUHZxdTNPMzBCM3FKNzdkb2EzbDFvc1RGUGF4MTFqeUZuZitidHBDK0grWlB4ajlKWDFVQXAK",
      "endpoints": [
        "https://github.com/ShanTirmizi/utter/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
